# 复制成 .env.local 供本地开发；线上在 Vercel 项目 Settings → Environment Variables 配置
# 不要在浏览器可访问的地方使用 NEXT_PUBLIC_ 前缀放这些值

# Cron 调用 /api/sync 时的鉴权（Vercel 会自动在请求头带 Authorization: Bearer <值>）
CRON_SECRET=replace-with-a-long-random-string

# 如果将来要把真实抓取搬进函数，再补下面两项（当前架构不需要）
# NETEASE_COOKIE=
# NETEASE_UID=
# STEAM_API_KEY=
# STEAM_ID=
